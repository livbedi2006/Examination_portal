# Environment Configuration
# Copy this to .env and fill in your actual values

# Backend
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Database
DATABASE_URL=sqlite:///./exam_system.db

# JWT
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth Configuration
# Get these from: https://console.developers.google.com/
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# OpenAI (optional for future AI features)
OPENAI_API_KEY=your-openai-api-key-here

# Proctoring
ENABLE_PROCTORING=true
PROCTORING_CONFIG_PATH=./Proctoring/config.json

# Paths to AI Models
QUESTIONS_CSV_PATH=./data/clean_questions.csv
DIFFICULTY_MODEL_PATH=./models/difficulty_model.pkl
VECTORIZER_PATH=./models/tfidf_vectorizer.pkl

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]

# Session
SESSION_TIMEOUT_MINUTES=180
