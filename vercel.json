{
  "version": 2,
  "rewrites": [
    { "source": "/auth/(.*)", "destination": "/api/index.py" },
    { "source": "/exams/(.*)", "destination": "/api/index.py" },
    { "source": "/proctoring/(.*)", "destination": "/api/index.py" },
    { "source": "/subjects/(.*)", "destination": "/api/index.py" },
    { "source": "/config/(.*)", "destination": "/api/index.py" },
    { "source": "/docs", "destination": "/api/index.py" },
    { "source": "/openapi.json", "destination": "/api/index.py" },
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/css/(.*)", "destination": "/frontend/css/$1" },
    { "source": "/js/(.*)", "destination": "/frontend/js/$1" },
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}
